<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Installs VFS365 for all users in Program Files\VFS365 and starts vfs365-agent.exe at every user's logon (HKLM Run).
    Needs WinFsp (the setup bundle installs it first). Settings come from policy (policy\VFS365.admx).
    Also installs the network provider vfs365np.dll (System32 and SysWOW64) so typed \\VFS365 paths work in Explorer.
    Removal runs vfs365.exe machine-stop as SYSTEM before files go: agents stop cleanly (Explorer entry removed, pending changes
    uploaded), and on a real uninstall (not an upgrade) per-user caches and Explorer entries are removed; unsaved changes are kept.
    An install or upgrade ends with vfs365.exe machine-start, which starts the agent in every signed-in session without one.
    With the MonitoringUrl device policy set, installs, updates and uninstalls are reported (vfs365.exe machine-report).
    A repair runs none of these.
  -->
  <Package Name="VFS365" Manufacturer="JSolve B.V." Version="$(Version)" UpgradeCode="{9E0B7C21-3F64-4D3A-8B65-2D9A6F0C3651}" Scope="perMachine" Compressed="yes">
    <!-- The older version goes inside this install's transaction, so a failed upgrade rolls back to it. A release cut again with the
         same version replaces the first cut instead of installing next to it. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of VFS365 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="vfs365.ico" SourceFile="$(AssetsDir)\vfs365.ico" />
    <Property Id="ARPPRODUCTICON" Value="vfs365.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.jsolve.nl" />
    <Property Id="ARPCOMMENTS" Value="Free software under the GNU GPLv3. Uses WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos, https://github.com/winfsp/winfsp" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Property Id="WINFSPDIR">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\WinFsp" Name="InstallDir" Type="raw" Bitness="always32" />
    </Property>
    <Launch Condition="Installed OR WINFSPDIR" Message="VFS365 needs WinFsp. Use the VFS365 setup, which installs it, or install WinFsp first (https://winfsp.dev)." />

<?if $(sys.BUILDARCH) = x64 ?>
    <!-- Windows runs x64 packages on ARM64, but the network provider would then be the wrong kind for System32 -->
    <Property Id="NATIVEARCH">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment" Name="PROCESSOR_ARCHITECTURE" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT NATIVEARCH~=&quot;ARM64&quot;" Message="This is the x64 package of VFS365. On ARM64 devices, install the arm64 package (VFS365-$(Version)-arm64.msi or VFS365-$(Version)-arm64-setup.exe)." />
<?endif?>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VFS365" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <Component Id="AutoStart" Directory="INSTALLFOLDER" Guid="{4B7E2D19-8C53-4A06-9F1E-6D2C3A5B0365}">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="VFS365" Type="string" Value="&quot;[INSTALLFOLDER]vfs365-agent.exe&quot;" />
      <!-- An earlier uninstall's Active Setup cleanup of Explorer entries (MachineCleanup.ActiveSetupKey) must not run once reinstalled -->
      <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Active Setup\Installed Components\{76103053-0966-49F3-9EE8-923401C976B1}" Action="removeOnInstall" />
    </Component>

    <!-- Start menu: starts the agent again after it was stopped (it runs once per session) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{1A021878-FCF8-4899-B01F-1FBEE5AA4288}">
        <Shortcut Id="AgentShortcut" Name="VFS365" Description="Start VFS365 (Microsoft 365 files as a drive)" Target="[INSTALLFOLDER]vfs365-agent.exe" WorkingDirectory="INSTALLFOLDER" Icon="vfs365.ico" />
        <RegistryValue Root="HKLM" Key="Software\JSolve\VFS365" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Network provider: lets the shell resolve typed \\VFS365 paths. MPR loads System32's copy in native processes and
         SysWOW64's in 32-bit ones. machine-setup puts it in the provider order. -->
    <StandardDirectory Id="System64Folder">
      <Component Id="NetworkProvider" Guid="{CD978663-A8CA-4185-9CC3-81FF1E1462B2}" Bitness="always64">
        <File Id="vfs365np.dll" Name="vfs365np.dll" Source="$(NpDll)" />
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\VFS365.Np">
          <RegistryValue Name="Group" Type="string" Value="NetworkProvider" />
          <RegistryKey Key="NetworkProvider">
            <RegistryValue Name="Name" Type="string" Value="VFS365" />
            <RegistryValue Name="ProviderPath" Type="expandable" Value="%SystemRoot%\System32\vfs365np.dll" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="SystemFolder">
      <Component Id="NetworkProvider32" Guid="{6AF861C5-E732-45B2-89ED-31CABFFB7FAB}" Bitness="always32">
        <File Id="vfs365np32.dll" Name="vfs365np.dll" Source="$(NpDllX86)" />
      </Component>
    </StandardDirectory>

    <!-- Custom actions run vfs365.exe as SYSTEM through WiX's WixQuietExec: no console window, which on a user's desktop would let that
         user run anything as SYSTEM, and the output goes to the MSI log. The command line is the action's CustomActionData, set
         just before it. None fails setup. -->
    <SetProperty Id="AddNetworkProvider" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-setup" Before="AddNetworkProvider" Sequence="execute" />
    <CustomAction Id="AddNetworkProvider" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Before the files go: stop every user's agent (upgrade), and on uninstall also remove their caches and Explorer entries -->
    <SetProperty Id="StopAgents" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-stop" Before="StopAgents" Sequence="execute" />
    <CustomAction Id="StopAgents" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="StopAgentsAndCleanUp" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-stop --cleanup" Before="StopAgentsAndCleanUp" Sequence="execute" />
    <CustomAction Id="StopAgentsAndCleanUp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Monitoring (policy MonitoringUrl for the device): install, update and uninstall go to the devices table; best effort -->
    <SetProperty Id="ReportInstall" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-report install" Before="ReportInstall" Sequence="execute" />
    <CustomAction Id="ReportInstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="ReportUpdate" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-report update" Before="ReportUpdate" Sequence="execute" />
    <CustomAction Id="ReportUpdate" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="ReportUninstall" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-report uninstall" Before="ReportUninstall" Sequence="execute" />
    <CustomAction Id="ReportUninstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Last: starts the agent as the user in every signed-in session without one (an upgrade stopped them) -->
    <SetProperty Id="StartAgents" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-start" Before="StartAgents" Sequence="execute" />
    <CustomAction Id="StartAgents" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Rollback of a failed upgrade: the older version is back by then, and its agents, which its removal stopped, start again -->
    <SetProperty Id="RestartAgentsOnRollback" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-start" Before="RestartAgentsOnRollback" Sequence="execute" />
    <CustomAction Id="RestartAgentsOnRollback" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="rollback" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RestartAgentsOnRollback" Before="RemoveExistingProducts" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="ReportUninstall" Before="StopAgentsAndCleanUp" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StopAgents" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
      <Custom Action="StopAgentsAndCleanUp" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="AddNetworkProvider" After="WriteRegistryValues" Condition="NOT Installed" />
      <Custom Action="ReportInstall" After="AddNetworkProvider" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ReportUpdate" After="ReportInstall" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="StartAgents" Before="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AutoStart" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="NetworkProvider" />
      <ComponentRef Id="NetworkProvider32" />
    </Feature>
  </Package>
</Wix>
