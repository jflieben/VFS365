<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Installs VFS365 for all users in Program Files\VFS365 and starts vfs365-agent.exe at every user's logon (HKLM Run).
    Needs WinFsp (the setup bundle installs it first). Settings come from policy (policy\VFS365.admx).
    Also installs the network provider vfs365np.dll (System32 and SysWOW64) so typed \\VFS365 paths work in Explorer, and the shell
    extension vfs365shell.dll (overlay icons; with the signed package vfs365shell.msix, the Windows 11 context menu).
    Removal runs vfs365.exe machine-stop as SYSTEM before files go: agents stop cleanly (Explorer entry removed, pending changes
    uploaded), and on a real uninstall (not an upgrade) per-user caches and Explorer entries are removed; unsaved changes are kept.
    An install or upgrade ends with vfs365.exe machine-start, which starts the agent in every signed-in session without one.
    With the MonitoringUrl device policy set, installs, updates and uninstalls are reported (vfs365.exe machine-report).
    A repair runs none of these.
  -->
  <Package Name="VFS365" Manufacturer="JSolve B.V." Version="$(Version)" UpgradeCode="{9E0B7C21-3F64-4D3A-8B65-2D9A6F0C3651}" Scope="perMachine" Compressed="yes">
    <!-- The older version is removed before files are installed (the default schedule). Not inside the transaction
         (afterInstallInitialize): files are then chosen while the older ones are still there, so those of the same version (the .NET
         runtime) are skipped and then removed with the older version. The setup (Burn) puts the older bundle back when an upgrade
         fails. A release cut again with the same version replaces the first cut instead of installing next to it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of VFS365 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="vfs365.ico" SourceFile="$(AssetsDir)\vfs365.ico" />
    <Property Id="ARPPRODUCTICON" Value="vfs365.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.jsolve.nl" />
    <Property Id="ARPCOMMENTS" Value="Free software under the GNU GPLv3. Uses WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos, https://github.com/winfsp/winfsp" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Property Id="WINFSPDIR">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\WinFsp" Name="InstallDir" Type="raw" Bitness="always32" />
    </Property>
    <Launch Condition="Installed OR WINFSPDIR" Message="VFS365 needs WinFsp. Use the VFS365 setup, which installs it, or install WinFsp first (https://winfsp.dev)." />

<?if $(sys.BUILDARCH) = x64 ?>
    <!-- Windows runs x64 packages on ARM64, but the network provider would then be the wrong kind for System32 -->
    <Property Id="NATIVEARCH">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment" Name="PROCESSOR_ARCHITECTURE" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT NATIVEARCH~=&quot;ARM64&quot;" Message="This is the x64 package of VFS365. On ARM64 devices, install the arm64 package (VFS365-$(Version)-arm64.msi or VFS365-$(Version)-arm64-setup.exe)." />
<?endif?>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VFS365">
        <Directory Id="SHELLX86FOLDER" Name="x86" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <Component Id="AutoStart" Directory="INSTALLFOLDER" Guid="{4B7E2D19-8C53-4A06-9F1E-6D2C3A5B0365}">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="VFS365" Type="string" Value="&quot;[INSTALLFOLDER]vfs365-agent.exe&quot;" />
      <!-- An earlier uninstall's Active Setup cleanup of Explorer entries (MachineCleanup.ActiveSetupKey) must not run once reinstalled -->
      <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Active Setup\Installed Components\{76103053-0966-49F3-9EE8-923401C976B1}" Action="removeOnInstall" />
    </Component>

    <!-- Event source VFS365 in the Application log (AgentEvents, IDs in docs/DEPLOYMENT.md): EventCreate.exe's message table has "%1"
         for IDs 1 to 1000, so each event shows its own text. Removed at uninstall. -->
    <Component Id="EventSource" Directory="INSTALLFOLDER" Guid="{3BBAAC83-E75F-4785-B0CF-BBE497856165}" Bitness="always64">
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\VFS365" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\System32\EventCreate.exe" KeyPath="yes" />
        <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
      </RegistryKey>
    </Component>

    <!-- Start menu: starts the agent again after it was stopped (it runs once per session) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{1A021878-FCF8-4899-B01F-1FBEE5AA4288}">
        <Shortcut Id="AgentShortcut" Name="VFS365" Description="Start VFS365 (Microsoft 365 files as a drive)" Target="[INSTALLFOLDER]vfs365-agent.exe" WorkingDirectory="INSTALLFOLDER" Icon="vfs365.ico" />
        <RegistryValue Root="HKLM" Key="Software\JSolve\VFS365" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Network provider: lets the shell resolve typed \\VFS365 paths. MPR loads System32's copy in native processes and
         SysWOW64's in 32-bit ones. machine-setup puts it in the provider order. -->
    <StandardDirectory Id="System64Folder">
      <Component Id="NetworkProvider" Guid="{CD978663-A8CA-4185-9CC3-81FF1E1462B2}" Bitness="always64">
        <File Id="vfs365np.dll" Name="vfs365np.dll" Source="$(NpDll)" />
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\VFS365.Np">
          <RegistryValue Name="Group" Type="string" Value="NetworkProvider" />
          <RegistryKey Key="NetworkProvider">
            <RegistryValue Name="Name" Type="string" Value="VFS365" />
            <RegistryValue Name="ProviderPath" Type="expandable" Value="%SystemRoot%\System32\vfs365np.dll" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="SystemFolder">
      <Component Id="NetworkProvider32" Guid="{6AF861C5-E732-45B2-89ED-31CABFFB7FAB}" Bitness="always32">
        <File Id="vfs365np32.dll" Name="vfs365np.dll" Source="$(NpDllX86)" />
      </Component>
    </StandardDirectory>

    <!-- Shell extension vfs365shell.dll (src\Vfs365.Shell): overlay icons on the volume's items, five classes registered here, the x86
       build for 32-bit programs' file dialogs (its keys written straight into the 32-bit view, WOW6432Node). Its Windows 11 context menu class is registered per user by the package
       vfs365shell.msix (signed releases only; ShellPackage.cs), never here. The overlay identifiers' names start with one space:
       Explorer loads only the first 11 in name order (it keeps 4 of its 15 slots), and this puts the four right after OneDrive's
       seven (" OneDrive1" to " OneDrive7"), most needed first. A downloading file shows online only, so it has no class of its own. -->
    <Component Id="ShellExtension" Directory="INSTALLFOLDER" Guid="{D7C4A21E-89F0-455F-85EC-687894ABC500}" Bitness="always64">
      <File Id="vfs365shell.dll" Name="vfs365shell.dll" Source="$(ShellDll)" KeyPath="yes" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{446CAE69-A613-4F61-B33B-6845715EF0E8}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: Problem" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 1 Problem" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{446CAE69-A613-4F61-B33B-6845715EF0E8}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{446CAE69-A613-4F61-B33B-6845715EF0E8}" Type="string" Value="VFS365 overlay: Problem" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{B7C851F1-2B15-49B3-B30E-769011CF84D2}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: Uploading" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 2 Uploading" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{B7C851F1-2B15-49B3-B30E-769011CF84D2}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{B7C851F1-2B15-49B3-B30E-769011CF84D2}" Type="string" Value="VFS365 overlay: Uploading" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{9DB55147-CB02-47F4-A386-E0EE3D556021}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: Cached" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 4 Cached" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{9DB55147-CB02-47F4-A386-E0EE3D556021}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{9DB55147-CB02-47F4-A386-E0EE3D556021}" Type="string" Value="VFS365 overlay: Cached" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{04668249-3350-4510-9629-814408AA98D3}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: OnlineOnly" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 3 OnlineOnly" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{04668249-3350-4510-9629-814408AA98D3}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{04668249-3350-4510-9629-814408AA98D3}" Type="string" Value="VFS365 overlay: OnlineOnly" />
    </Component>
    <Component Id="ShellExtension32" Directory="SHELLX86FOLDER" Guid="{12F777DB-F0E0-43B4-85E1-01C5613CD881}" Bitness="always64">
      <File Id="vfs365shell32.dll" Name="vfs365shell.dll" Source="$(ShellDllX86)" KeyPath="yes" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\WOW6432Node\CLSID\{446CAE69-A613-4F61-B33B-6845715EF0E8}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: Problem" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell32.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 1 Problem" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{446CAE69-A613-4F61-B33B-6845715EF0E8}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{446CAE69-A613-4F61-B33B-6845715EF0E8}" Type="string" Value="VFS365 overlay: Problem" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\WOW6432Node\CLSID\{B7C851F1-2B15-49B3-B30E-769011CF84D2}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: Uploading" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell32.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 2 Uploading" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{B7C851F1-2B15-49B3-B30E-769011CF84D2}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{B7C851F1-2B15-49B3-B30E-769011CF84D2}" Type="string" Value="VFS365 overlay: Uploading" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\WOW6432Node\CLSID\{9DB55147-CB02-47F4-A386-E0EE3D556021}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: Cached" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell32.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 4 Cached" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{9DB55147-CB02-47F4-A386-E0EE3D556021}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{9DB55147-CB02-47F4-A386-E0EE3D556021}" Type="string" Value="VFS365 overlay: Cached" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\WOW6432Node\CLSID\{04668249-3350-4510-9629-814408AA98D3}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="VFS365 overlay: OnlineOnly" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#vfs365shell32.dll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ VFS365 3 OnlineOnly" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="{04668249-3350-4510-9629-814408AA98D3}" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{04668249-3350-4510-9629-814408AA98D3}" Type="string" Value="VFS365 overlay: OnlineOnly" />
    </Component>
<?if $(ShellMsix) != "" ?>
    <Component Id="ShellPackage" Directory="INSTALLFOLDER" Guid="{CCD50449-13C7-44EE-A035-EB62E7475B24}">
      <File Id="vfs365shell.msix" Name="vfs365shell.msix" Source="$(ShellMsix)" KeyPath="yes" />
    </Component>
<?endif?>

    <!-- Custom actions run vfs365.exe as SYSTEM through WiX's WixQuietExec: no console window, which on a user's desktop would let that
         user run anything as SYSTEM, and the output goes to the MSI log. The command line is the action's CustomActionData, set
         just before it. None fails setup. -->
    <SetProperty Id="AddNetworkProvider" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-setup" Before="AddNetworkProvider" Sequence="execute" />
    <CustomAction Id="AddNetworkProvider" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Before the files go: stop every user's agent (upgrade), and on uninstall also remove their caches and Explorer entries -->
    <SetProperty Id="StopAgents" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-stop" Before="StopAgents" Sequence="execute" />
    <CustomAction Id="StopAgents" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="StopAgentsAndCleanUp" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-stop --cleanup" Before="StopAgentsAndCleanUp" Sequence="execute" />
    <CustomAction Id="StopAgentsAndCleanUp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Monitoring (policy MonitoringUrl for the device): install, update and uninstall go to the devices table; best effort -->
    <SetProperty Id="ReportInstall" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-report install" Before="ReportInstall" Sequence="execute" />
    <CustomAction Id="ReportInstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="ReportUpdate" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-report update" Before="ReportUpdate" Sequence="execute" />
    <CustomAction Id="ReportUpdate" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="ReportUninstall" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-report uninstall" Before="ReportUninstall" Sequence="execute" />
    <CustomAction Id="ReportUninstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Last: starts the agent as the user in every signed-in session without one (an upgrade stopped them) -->
    <SetProperty Id="StartAgents" Value="&quot;[INSTALLFOLDER]vfs365.exe&quot; machine-start" Before="StartAgents" Sequence="execute" />
    <CustomAction Id="StartAgents" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ReportUninstall" Before="StopAgentsAndCleanUp" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StopAgents" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
      <Custom Action="StopAgentsAndCleanUp" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="AddNetworkProvider" After="WriteRegistryValues" Condition="NOT Installed" />
      <Custom Action="ReportInstall" After="AddNetworkProvider" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ReportUpdate" After="ReportInstall" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="StartAgents" Before="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AutoStart" />
      <ComponentRef Id="EventSource" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="NetworkProvider" />
      <ComponentRef Id="NetworkProvider32" />
      <ComponentRef Id="ShellExtension" />
      <ComponentRef Id="ShellExtension32" />
<?if $(ShellMsix) != "" ?>
      <ComponentRef Id="ShellPackage" />
<?endif?>
    </Feature>
  </Package>
</Wix>
