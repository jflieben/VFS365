<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Per-machine MSI. Build through ./build.ps1 release, which passes Platform (x64 or arm64), Version, PublishDir, the network
       provider DLLs (NpDll for the platform, NpDllX86), the shell extension DLLs (ShellDll, ShellDllX86) and the Windows 11 menu
       package (ShellMsix; empty when there is none). -->

  <PropertyGroup>
    <OutputName>VFS365</OutputName>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <InstallerPlatform>$(Platform)</InstallerPlatform>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\assets;NpDll=$(NpDll);NpDllX86=$(NpDllX86);ShellDll=$(ShellDll);ShellDllX86=$(ShellDllX86);ShellMsix=$(ShellMsix)</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The setup project in bundle\ leaves .wxl files in its obj folder; they must not be globbed into the MSI -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bundle\**</DefaultItemExcludes>
    <!-- ICE38, 43, 57 expect Start menu shortcuts in the user's profile with an HKCU key path; this per-machine package uses the all-users
         one. ICE61: same-version upgrades are on purpose. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>

  <!-- WixQuietExec runs the custom actions without a console window -->
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- Signing: build.ps1 passes SignOutput=true when signing is configured and signs through its sign task. The cab is embedded. -->
  <PropertyGroup>
    <SignOutputCabs>false</SignOutputCabs>
  </PropertyGroup>
  <Target Name="SignMsi">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\build.ps1&quot; sign &quot;%(SignMsi.FullPath)&quot;" />
  </Target>

</Project>
