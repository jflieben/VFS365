<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="vfs365" namespace="JSolve.Policies.VFS365" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Windows11" displayName="$(string.SUPPORTED_Windows11)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="JSolve" displayName="$(string.JSolve)" />
    <category name="VFS365" displayName="$(string.VFS365)">
      <parentCategory ref="JSolve" />
    </category>
    <category name="VFS365_Api" displayName="$(string.VFS365_Api)">
      <parentCategory ref="VFS365" />
    </category>
    <category name="VFS365_Monitoring" displayName="$(string.VFS365_Monitoring)">
      <parentCategory ref="VFS365" />
    </category>
  </categories>
  <policies>
    <policy name="ClientId" class="Both" displayName="$(string.ClientId)" explainText="$(string.ClientId_Help)" presentation="$(presentation.ClientId)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <text id="ClientId" valueName="ClientId" required="true" />
      </elements>
    </policy>
    <policy name="TenantId" class="Both" displayName="$(string.TenantId)" explainText="$(string.TenantId_Help)" presentation="$(presentation.TenantId)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <text id="TenantId" valueName="TenantId" required="true" />
      </elements>
    </policy>
    <policy name="DriveLetter" class="Both" displayName="$(string.DriveLetter)" explainText="$(string.DriveLetter_Help)" presentation="$(presentation.DriveLetter)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <text id="DriveLetter" valueName="DriveLetter" required="true" maxLength="4" />
      </elements>
    </policy>
    <policy name="Label" class="Both" displayName="$(string.Label)" explainText="$(string.Label_Help)" presentation="$(presentation.Label)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <text id="Label" valueName="Label" required="true" maxLength="32" />
      </elements>
    </policy>
    <policy name="Scope" class="Both" displayName="$(string.Scope)" explainText="$(string.Scope_Help)" presentation="$(presentation.Scope)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <enum id="Scope" valueName="Scope" required="true">
          <item displayName="$(string.Scope_SharePoint)"><value><string>SharePoint</string></value></item>
          <item displayName="$(string.Scope_OneDrive)"><value><string>OneDrive</string></value></item>
          <item displayName="$(string.Scope_All)"><value><string>All</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="IncludedSites" class="Both" displayName="$(string.IncludedSites)" explainText="$(string.IncludedSites_Help)" presentation="$(presentation.IncludedSites)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <multiText id="IncludedSites" valueName="IncludedSites" />
      </elements>
    </policy>
    <policy name="ExcludedSites" class="Both" displayName="$(string.ExcludedSites)" explainText="$(string.ExcludedSites_Help)" presentation="$(presentation.ExcludedSites)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <multiText id="ExcludedSites" valueName="ExcludedSites" />
      </elements>
    </policy>
    <policy name="IncludedSiteTemplates" class="Both" displayName="$(string.IncludedSiteTemplates)" explainText="$(string.IncludedSiteTemplates_Help)" presentation="$(presentation.IncludedSiteTemplates)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <multiText id="IncludedSiteTemplates" valueName="IncludedSiteTemplates" />
      </elements>
    </policy>
    <policy name="ExcludedSiteTemplates" class="Both" displayName="$(string.ExcludedSiteTemplates)" explainText="$(string.ExcludedSiteTemplates_Help)" presentation="$(presentation.ExcludedSiteTemplates)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <multiText id="ExcludedSiteTemplates" valueName="ExcludedSiteTemplates" />
      </elements>
    </policy>
    <policy name="CacheSizeMB" class="Both" displayName="$(string.CacheSizeMB)" explainText="$(string.CacheSizeMB_Help)" presentation="$(presentation.CacheSizeMB)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="CacheSizeMB" valueName="CacheSizeMB" required="true" minValue="100" maxValue="1048576" />
      </elements>
    </policy>
    <policy name="TrayIcon" class="Both" displayName="$(string.TrayIcon)" explainText="$(string.TrayIcon_Help)" key="Software\Policies\JSolve\VFS365" valueName="TrayIcon">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="PinnedLocations" class="Both" displayName="$(string.PinnedLocations)" explainText="$(string.PinnedLocations_Help)" presentation="$(presentation.PinnedLocations)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <multiText id="PinnedLocations" valueName="PinnedLocations" />
      </elements>
    </policy>
    <policy name="ChangeCheckSeconds" class="Both" displayName="$(string.ChangeCheckSeconds)" explainText="$(string.ChangeCheckSeconds_Help)" presentation="$(presentation.ChangeCheckSeconds)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365_Api" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="ChangeCheckSeconds" valueName="ChangeCheckSeconds" required="true" minValue="0" maxValue="300" />
      </elements>
    </policy>
    <policy name="ApiBudgetPerMinute" class="Both" displayName="$(string.ApiBudgetPerMinute)" explainText="$(string.ApiBudgetPerMinute_Help)" presentation="$(presentation.ApiBudgetPerMinute)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365_Api" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="ApiBudgetPerMinute" valueName="ApiBudgetPerMinute" required="true" minValue="0" maxValue="100000" />
      </elements>
    </policy>
    <policy name="ThrottlePauseMinutes" class="Both" displayName="$(string.ThrottlePauseMinutes)" explainText="$(string.ThrottlePauseMinutes_Help)" presentation="$(presentation.ThrottlePauseMinutes)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365_Api" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="ThrottlePauseMinutes" valueName="ThrottlePauseMinutes" required="true" minValue="0" maxValue="240" />
      </elements>
    </policy>
    <policy name="WalkPrefetchFolders" class="Both" displayName="$(string.WalkPrefetchFolders)" explainText="$(string.WalkPrefetchFolders_Help)" presentation="$(presentation.WalkPrefetchFolders)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365_Api" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="WalkPrefetchFolders" valueName="WalkPrefetchFolders" required="true" minValue="0" maxValue="200" />
      </elements>
    </policy>
    <policy name="ReadAheadFiles" class="Both" displayName="$(string.ReadAheadFiles)" explainText="$(string.ReadAheadFiles_Help)" presentation="$(presentation.ReadAheadFiles)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365_Api" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="ReadAheadFiles" valueName="ReadAheadFiles" required="true" minValue="0" maxValue="64" />
      </elements>
    </policy>
    <policy name="BackgroundUploads" class="Both" displayName="$(string.BackgroundUploads)" explainText="$(string.BackgroundUploads_Help)" key="Software\Policies\JSolve\VFS365" valueName="BackgroundUploads">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="RepeatSaveSeconds" class="Both" displayName="$(string.RepeatSaveSeconds)" explainText="$(string.RepeatSaveSeconds_Help)" presentation="$(presentation.RepeatSaveSeconds)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <decimal id="RepeatSaveSeconds" valueName="RepeatSaveSeconds" required="true" minValue="0" maxValue="600" />
      </elements>
    </policy>
    <policy name="MonitoringUrl" class="Both" displayName="$(string.MonitoringUrl)" explainText="$(string.MonitoringUrl_Help)" presentation="$(presentation.MonitoringUrl)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365_Monitoring" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <text id="MonitoringUrl" valueName="MonitoringUrl" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="DatabaseFiles" class="Both" displayName="$(string.DatabaseFiles)" explainText="$(string.DatabaseFiles_Help)" presentation="$(presentation.DatabaseFiles)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <enum id="DatabaseFiles" valueName="DatabaseFiles" required="true">
          <item displayName="$(string.DatabaseFiles_Allow)"><value><string>Allow</string></value></item>
          <item displayName="$(string.DatabaseFiles_ReadOnly)"><value><string>ReadOnly</string></value></item>
          <item displayName="$(string.DatabaseFiles_Block)"><value><string>Block</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="HelpUrl" class="Both" displayName="$(string.HelpUrl)" explainText="$(string.HelpUrl_Help)" presentation="$(presentation.HelpUrl)" key="Software\Policies\JSolve\VFS365">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <elements>
        <text id="HelpUrl" valueName="HelpUrl" required="true" maxLength="2048" />
      </elements>
    </policy>
    <policy name="NavigationPane" class="Both" displayName="$(string.NavigationPane)" explainText="$(string.NavigationPane_Help)" key="Software\Policies\JSolve\VFS365" valueName="NavigationPane">
      <parentCategory ref="VFS365" />
      <supportedOn ref="SUPPORTED_Windows11" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
  </policies>
</policyDefinitions>
