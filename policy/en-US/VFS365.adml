<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>VFS365</displayName>
  <description>Settings for VFS365, which shows Microsoft 365 files as a drive and in Explorer's navigation pane.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Windows11">Windows 11 with WinFsp and VFS365 installed</string>
      <string id="JSolve">JSolve</string>
      <string id="VFS365">VFS365</string>
      <string id="VFS365_Api">Microsoft 365 API use</string>
      <string id="VFS365_Monitoring">Monitoring</string>

      <string id="ClientId">App registration</string>
      <string id="ClientId_Help">Application (client) ID of your own Entra app registration for VFS365 to sign in with. Not configured: JSolve's multi-tenant app, which an admin consents to once per tenant. Delegated permissions only; see the app registration guide.</string>

      <string id="TenantId">Force tenant</string>
      <string id="TenantId_Help">Tenant (directory) ID to sign in to. Normally not needed: VFS365 uses the tenant the device is joined or registered to, else the tenant of the account that signs in.</string>

      <string id="DriveLetter">Drive letter</string>
      <string id="DriveLetter_Help">Drive letter for the drive, for example M. Use * for the first free letter counting down from Z, or None for no drive letter (the default when not configured): the files are then reachable through the navigation pane and the UNC path \\VFS365\&lt;user name&gt; only. On multi-session hosts a drive letter gives every user the same path.

For a drive letter only, set a letter here and disable "Show in the navigation pane". The UNC path always works as well.</string>

      <string id="Label">Name</string>
      <string id="Label_Help">Name of the drive and of the navigation pane entry in Explorer. Default: VFS365.</string>

      <string id="Scope">Content</string>
      <string id="Scope_Help">What the drive shows. Only SharePoint sites (the default when not configured) or only OneDrive: that content is the root of the drive, without the extra folder level. Everything: OneDrive and Sites folders.</string>
      <string id="Scope_All">Everything</string>
      <string id="Scope_OneDrive">Only OneDrive</string>
      <string id="Scope_SharePoint">Only SharePoint sites</string>

      <string id="IncludedSites">Included sites</string>
      <string id="IncludedSites_Help">Site URL patterns to show, one per line. * matches any characters; patterns match the whole URL. Default: */sites/* and */teams/*. Exclusions win.</string>

      <string id="ExcludedSites">Excluded sites</string>
      <string id="ExcludedSites_Help">Site URL patterns to hide, one per line, for example */sites/HR*. Replaces the built-in list (app catalog, content type hub, Viva Engage and similar system sites).</string>

      <string id="CacheSizeMB">Cache size</string>
      <string id="CacheSizeMB_Help">Most space, in MB, that copies of opened files take per user (encrypted, in %LOCALAPPDATA%\VFS365\cache). The least recently used go first. Default 2048, at least 100.</string>

      <string id="TrayIcon">Tray icon and notifications</string>
      <string id="TrayIcon_Help">Shows a VFS365 icon in the notification area with its status, and notifications for conflict copies, uploads that wait and sign-in problems. Enabled by default; disable to show neither.</string>

      <string id="PinnedLocations">Pinned locations</string>
      <string id="PinnedLocations_Help">Site or library addresses to show for everyone who can open them, one per line, also where SharePoint Search doesn't find them (Restricted Content Discovery, sites excluded from search, the root site, portals, new sites). A link copied from the browser works. Users add their own with vfs365.exe pin.</string>

      <string id="ChangeCheckSeconds">Change check interval</string>
      <string id="ChangeCheckSeconds_Help">How often, in seconds, a library someone used in the last 2 minutes is checked for changes made elsewhere, on top of SharePoint's push notifications (which take 20 to 30 seconds). Default 20; 0 leaves it to push notifications; 5 to 300. Each check costs 1 resource unit of the tenant's API budget. Checking pauses after Microsoft throttles (see "Pause after throttling").</string>

      <string id="ApiBudgetPerMinute">API budget per user</string>
      <string id="ApiBudgetPerMinute_Help">The most SharePoint resource units one user's VFS365 uses per minute. Default 600; 0: no limit of its own; at least 60.

Microsoft limits every app per tenant, for all its users together: 1,250 resource units per minute up to 1,000 licenses, rising to 6,250 above 50,000 licenses, plus limits per user. Listing a folder costs 2 units; opening a file or checking for changes 1. VFS365 users share their tenant's budget for the app they sign in with (JSolve's app or your own). See https://learn.microsoft.com/en-us/sharepoint/dev/general-development/how-to-avoid-getting-throttled-or-blocked-in-sharepoint-online#application-throttling

Normal use stays far below the default. It caps peaks, such as copying a large folder tree, so one user can't use up most of a small tenant's budget. Background work (loading ahead, change checks, discovery) only uses the second half of the budget, so what users wait for goes first. Lower it when many users work at the same time in a tenant with few licenses; raise it for larger tenants. Requests wait when the budget is used up; nothing fails.</string>

      <string id="ThrottlePauseMinutes">Pause after throttling</string>
      <string id="ThrottlePauseMinutes_Help">When Microsoft throttles (HTTP 429 or 503), every request waits as long as Microsoft asks. On top of that, background work (loading folders ahead of a tree walk, the frequent change check) stops for this many minutes. Default 15; 0 to 240. See https://learn.microsoft.com/en-us/sharepoint/dev/general-development/how-to-avoid-getting-throttled-or-blocked-in-sharepoint-online#application-throttling</string>

      <string id="WalkPrefetchFolders">Folders loaded ahead of a tree walk</string>
      <string id="WalkPrefetchFolders_Help">When an app walks a folder tree (copying, searching or backing up a folder with its subfolders), VFS365 lists the next folders before the app gets there, two at a time. This sets how many folders it may have listed ahead that the app hasn't opened yet. Default 10; 0 turns it off; at most 200.

The app would list these folders anyway, so a walk that runs to the end costs nothing extra. When the app stops early, at most this many listings (2 resource units each) were made for nothing. Opening folders one by one in Explorer never loads anything ahead.</string>

      <string id="ReadAheadFiles">Files downloaded ahead of a copy</string>
      <string id="ReadAheadFiles_Help">When files of a library are read one after another (copying a folder out of the drive), VFS365 downloads the next small files (up to 4 MB) of that folder before the app asks for them, four at a time. This sets how many it may have downloaded ahead that the app hasn't opened yet. Default 8; 0 turns it off; at most 64.

The copy would download these files anyway, so a copy that runs to the end costs nothing extra. When it stops early, at most this many files were downloaded for nothing. Opening a file or two never downloads anything ahead.</string>

      <string id="BackgroundUploads">Upload new files in the background</string>
      <string id="BackgroundUploads_Help">Enabled (the default): a new file is kept safely on the PC when the app closes it, and uploads right after, four at a time. Copying many small files to the drive then runs at disk speed instead of waiting for every upload. Saves into existing files are unaffected: they upload before the app's close returns, so a conflict reaches the app.

Disabled: every new file uploads before its close returns, one after another.

Files that are still uploading show as waiting in the tray. If the PC stops first, they upload at the next start.</string>

      <string id="RepeatSaveSeconds">Combine quick repeated saves</string>
      <string id="RepeatSaveSeconds_Help">Some apps open a file, add a little and close it again, many times (log files, exports written line by line). Every close uploads the whole file, which for a large file costs time and traffic each time. A file closed again within this many seconds of its last upload uploads once, at the end of that time. Default 30; 0 uploads on every close; at most 600.

The changes are kept safely on the PC until then. Saves by Office and other apps that replace the file (save to a temporary file, then rename) are not affected.</string>

      <string id="MonitoringUrl">Report to Azure table storage</string>
      <string id="MonitoringUrl_Help">A table service SAS URL of your own Azure storage account, for example https://account.table.core.windows.net/?sv=...&amp;ss=t&amp;srt=o&amp;sp=a&amp;se=...&amp;sig=... Not configured: nothing is reported.

When set, VFS365 adds rows to three tables, which must exist: errors (each error at once, with device, user and details; at most 20 an hour per user), statistics (one row per user and device per day, sent the next day: requests, resource units, data received and sent, throttling, errors, version) and devices (installs, updates and uninstalls). Set it as a computer policy to get install, update and uninstall reports.

The SAS only needs the Add permission on objects of the Table service (ss=t, srt=o, sp=a): VFS365 never reads or changes rows. Reporting is best effort: nothing waits for it and nothing is retried; the first failure is written to the local log once. Renew the SAS before it expires. Instructions: https://jsolve.nl</string>

      <string id="DatabaseFiles">Multi-user database files</string>
      <string id="DatabaseFiles_Help">What happens with Access, QuickBooks and SQLite files (.accdb, .mdb, .qbw, .sqlite and their lock files). Their locks only work on one PC, so when two people change the same database from two PCs, the second save becomes a conflict copy that someone has to merge by hand. Allow: like any file (default). Read-only: they open for reading only. Block: they are listed but don't open.</string>
      <string id="DatabaseFiles_Allow">Allow</string>
      <string id="DatabaseFiles_ReadOnly">Read-only</string>
      <string id="DatabaseFiles_Block">Block</string>

      <string id="HelpUrl">Help link</string>
      <string id="HelpUrl_Help">Web page the tray icon's Help opens, for example your organisation's own instructions. An http or https address. Default: https://jsolve.nl.</string>

      <string id="NavigationPane">Show in the navigation pane</string>
      <string id="NavigationPane_Help">Shows the drive as its own entry in Explorer's navigation pane and in Open and Save dialogs. Enabled by default.

Disabled: no entry. With a drive letter (see "Drive letter") the drive shows under This PC with that letter only. Without a drive letter only the UNC path \\VFS365\&lt;user name&gt; is left.</string>
    </stringTable>
    <presentationTable>
      <presentation id="ClientId"><textBox refId="ClientId"><label>Client ID</label></textBox></presentation>
      <presentation id="TenantId"><textBox refId="TenantId"><label>Tenant ID</label></textBox></presentation>
      <presentation id="DriveLetter"><textBox refId="DriveLetter"><label>Drive letter, * or None</label><defaultValue>M</defaultValue></textBox></presentation>
      <presentation id="Label"><textBox refId="Label"><label>Name</label><defaultValue>VFS365</defaultValue></textBox></presentation>
      <presentation id="Scope"><dropdownList refId="Scope" defaultItem="0">Show</dropdownList></presentation>
      <presentation id="IncludedSites"><multiTextBox refId="IncludedSites">Site URL patterns, one per line</multiTextBox></presentation>
      <presentation id="CacheSizeMB"><decimalTextBox refId="CacheSizeMB" defaultValue="2048">MB</decimalTextBox></presentation>
      <presentation id="PinnedLocations"><multiTextBox refId="PinnedLocations">Site or library addresses, one per line</multiTextBox></presentation>
      <presentation id="ChangeCheckSeconds"><decimalTextBox refId="ChangeCheckSeconds" defaultValue="20">Seconds (0: push notifications only)</decimalTextBox></presentation>
      <presentation id="ApiBudgetPerMinute"><decimalTextBox refId="ApiBudgetPerMinute" defaultValue="600">Resource units per minute (0: no limit of its own)</decimalTextBox></presentation>
      <presentation id="ThrottlePauseMinutes"><decimalTextBox refId="ThrottlePauseMinutes" defaultValue="15">Minutes</decimalTextBox></presentation>
      <presentation id="WalkPrefetchFolders"><decimalTextBox refId="WalkPrefetchFolders" defaultValue="10">Folders (0: off)</decimalTextBox></presentation>
      <presentation id="ReadAheadFiles"><decimalTextBox refId="ReadAheadFiles" defaultValue="8">Files (0: off)</decimalTextBox></presentation>
      <presentation id="RepeatSaveSeconds"><decimalTextBox refId="RepeatSaveSeconds" defaultValue="30">Seconds (0: upload on every close)</decimalTextBox></presentation>
      <presentation id="MonitoringUrl"><textBox refId="MonitoringUrl"><label>Table service SAS URL</label></textBox></presentation>
      <presentation id="DatabaseFiles"><dropdownList refId="DatabaseFiles" defaultItem="0">Database files</dropdownList></presentation>
      <presentation id="HelpUrl"><textBox refId="HelpUrl"><label>Address</label><defaultValue>https://jsolve.nl</defaultValue></textBox></presentation>
      <presentation id="ExcludedSites"><multiTextBox refId="ExcludedSites">Site URL patterns, one per line</multiTextBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
