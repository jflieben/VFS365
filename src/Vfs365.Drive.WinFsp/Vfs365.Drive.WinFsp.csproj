    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="winfsp.net" />
    <ProjectReference Include="..\Vfs365.Core\Vfs365.Core.csproj" />
  </ItemGroup>

</Project>
