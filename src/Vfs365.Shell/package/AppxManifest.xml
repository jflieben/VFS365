<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package (package with external location) that gives vfs365shell.dll's menu a place in Windows 11's context menu, which
  takes commands only from packages. Its files are the install folder's (the external location the agent registers it with):
  the package itself holds only this manifest. build.ps1 release sets Version (VERSION.0) and Publisher (the signing certificate's
  subject) and packs it with makeappx; unsigned, Windows refuses it, so unsigned releases ship none.
  The class ID is vfs365shell.c's menu class.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">
  <Identity Name="JSolve.VFS365.Shell" Publisher="CN=Unsigned" Version="0.0.0.0" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>VFS365</DisplayName>
    <PublisherDisplayName>JSolve B.V.</PublisherDisplayName>
    <Logo>vfs365shell.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="VFS365" Executable="vfs365-agent.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="VFS365" Description="Microsoft 365 files as a drive" BackgroundColor="transparent"
        Square150x150Logo="vfs365shell.png" Square44x44Logo="vfs365shell.png" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="VFS365 Explorer menu">
              <com:Class Id="A7AED2F3-B922-46C7-BBAB-64B986061C74" Path="vfs365shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="VFS365" Clsid="A7AED2F3-B922-46C7-BBAB-64B986061C74" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="VFS365" Clsid="A7AED2F3-B922-46C7-BBAB-64B986061C74" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
